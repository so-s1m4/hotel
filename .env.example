# Optional LLM integration. Default run.py replay is offline; --llm opts in.
# The ingestion model path can load .env; never commit a populated .env file.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# json_schema enables constrained generation on compatible local/hosted servers.
LLM_RESPONSE_FORMAT=json_object
# contract keeps the full generation shape; extraction leaves UTC to host code.
LLM_GENERATION_PROFILE=contract
# Optional 1..16384 output cap; truncated completions become reviewed fallback.
LLM_MAX_TOKENS=
LLM_TIMEOUT_SECONDS=15
LLM_CACHE_DIR=.cache/llm

# Guest-message extraction (ingestion/guest_parser.py). All optional: without a
# key the pipeline runs offline and intents fall back to the dataset label.
# Provider shortcuts (used when LLM_API_KEY is empty); a model must be named.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# 1 = never call a model (CI / holdout dry run)
GUEST_PARSER_OFFLINE=
GUEST_PARSER_CACHE_DIR=.cache/guest_parser
GUEST_PARSER_WORKERS=6
# Local Ollama example (dummy key, no cloud):
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=ministral-3:3b
# LLM_RESPONSE_FORMAT=json_schema
# LLM_GENERATION_PROFILE=extraction
# LLM_MAX_TOKENS=512
# GUEST_PARSER_WORKERS=1
