# Optional future LLM integration. No API key is required for scaffold checks.
# The parser owner implements environment loading; this file is not auto-loaded.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_CACHE_DIR=.cache/llm

# Guest-message extraction (ingestion/guest_parser.py). All optional: without a
# key the pipeline runs offline and intents fall back to the dataset label.
# Provider shortcuts (used when LLM_API_KEY is empty); a model must be named.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# 1 = never call a model (CI / holdout dry run)
GUEST_PARSER_OFFLINE=
GUEST_PARSER_CACHE_DIR=.cache/guest_parser
GUEST_PARSER_WORKERS=6
